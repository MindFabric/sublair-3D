# Docker Environment Configuration for Sublair 3D
# Copy this file to .env and fill in your actual values

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NODE_ENV=production
PORT=3000
RTMP_PORT=1935

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================
# Get these from Firebase Console > Project Settings > Service Accounts

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_API_KEY=your-web-api-key

# Optional Firebase settings
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# DOMAIN CONFIGURATION (for production)
# ==========================================
# Update these with your actual domain
DOMAIN=3d.sublair.com
# SSL_EMAIL=your-email@example.com  # For Let's Encrypt

# ==========================================
# STREAMING CONFIGURATION
# ==========================================
# RTMP settings are handled by node-media-server internally
# Default RTMP URL: rtmp://your-domain:1935/live
# Default HTTP-FLV URL: http://your-domain:8888/live/{streamKey}.flv

# ==========================================
# SECURITY (Optional)
# ==========================================
# Add any API keys or secrets here
# SESSION_SECRET=your-random-secret-string

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================
# Uncomment for development/debugging
# DEBUG=*
# LOG_LEVEL=debug
